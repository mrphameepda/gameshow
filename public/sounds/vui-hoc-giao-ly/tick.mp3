<script>
(function(){
  var startedAt = Date.now();
  var nonce = "1790773066.2a20b43c265408b17dcc537095b4ac38.c37b4318a1a1a4315643cd445f2fd1e22ea7fe1f69a7b52e11cba07be5e066fd";
  var difficulty = 18;
  var MAX_AUTO_ATTEMPTS = 3;
  var SOLVE_TIMEOUT_MS = 10000;
  var SUBMIT_TIMEOUT_MS = 6000;
  var ATTEMPT_KEY = 'osh_challenge_attempts';
  var attempts = 0;
  function safeRedirectTarget(value){
    if(typeof value !== 'string') return '/';
    for(var i = 0; i < value.length; i++){
      var c = value.charCodeAt(i);
      if(c < 0x20 || c === 0x7f || c === 0x5c) return '/';
    }
    var s = value.trim();
    if(!s || s.charAt(0) !== '/' || s.charAt(1) === '/' || s.charAt(1) === '\\') return '/';
    return s;
  }

  // Redirect is not injected server-side — capture the current URL and sanitize.
  var redirect = safeRedirectTarget(window.location.pathname + window.location.search);

  try { attempts = parseInt(sessionStorage.getItem(ATTEMPT_KEY) || '0', 10) || 0; } catch(e) {}

  function recordAttempt(){
    attempts++;
    try { sessionStorage.setItem(ATTEMPT_KEY, String(attempts)); } catch(e) {}
  }

  function showFallback(hardFailure){
    if(typeof hardFailure !== 'boolean') hardFailure = true;
    clearTimeout(slowTimer);
    var title = document.getElementById('fallback-title');
    var message = document.getElementById('fallback-message');
    if(hardFailure){
      title.textContent = 'The security check could not finish';
      message.textContent = 'Verification could not finish automatically. Select the button below to try again with a fresh check.';
    }
    document.getElementById('fallback').classList.add('visible');
  }

  function reportOutcome(state){
    var probeUrl = '/_obs_challenge_probe'
                 + '?nonce=' + encodeURIComponent(nonce)
                 + '&state=' + encodeURIComponent(state)
                 + '&elapsed=' + encodeURIComponent(String(Date.now() - startedAt))
                 + '&redirect=' + encodeURIComponent(redirect);
    fetch(probeUrl, { method: 'GET', keepalive: true }).catch(function(){});
  }

  // The page stays blank while the PoW runs; this timer exists only to beacon a slow solve.
  var slowTimer = setTimeout(function(){
    reportOutcome('slow');
  }, 5000);

  function checkLeadingZeros(view, bits){
    var full = Math.floor(bits / 8), rem = bits % 8;
    for(var b = 0; b < full; b++){ if(view.getUint8(b) !== 0) return false; }
    if(rem > 0 && full < view.byteLength){
      var mask = (0xFF << (8 - rem)) & 0xFF;
      if((view.getUint8(full) & mask) !== 0) return false;
    }
    return true;
  }

  async function solve(){
    var enc = new TextEncoder();
    var i = 0;
    var cancelled = false;
    var timeout;
    var deadline = new Promise(function(_, reject){
      timeout = setTimeout(function(){
        cancelled = true;
        reject(new Error('proof of work timed out'));
      }, SOLVE_TIMEOUT_MS);
    });
    var work = (async function(){
    while(!cancelled){
      var sol = i.toString(16).padStart(16,'0');
      var buf = await crypto.subtle.digest('SHA-256', enc.encode(nonce + sol));
      if(cancelled) break;
      if(checkLeadingZeros(new DataView(buf), difficulty)) return sol;
      i++;
      if(i % 8000 === 0){
        await new Promise(function(r){ setTimeout(r, 0); });
      }
    }
    throw new Error('proof of work timed out');
    })();
    try {
      return await Promise.race([work, deadline]);
    } finally {
      clearTimeout(timeout);
    }
  }

  function submit(solution){
    var body = 'nonce=' + encodeURIComponent(nonce)
             + '&solution=' + encodeURIComponent(solution)
             + '&redirect=' + encodeURIComponent(redirect);
    var ctl = (typeof AbortController === 'function') ? new AbortController() : null;
    var timeout;
    var deadline = new Promise(function(_, reject){
      timeout = setTimeout(function(){
        if(ctl) ctl.abort();
        reject(new Error('challenge submission timed out'));
      }, SUBMIT_TIMEOUT_MS);
    });
    var request = fetch('/_osh/challenge',{
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded','X-Osh-Fetch':'1'},
      body: body,
      signal: ctl ? ctl.signal : undefined
    });
    return Promise.race([request, deadline]).finally(function(){ clearTimeout(timeout); });
  }

  function verify(){
    var retry = document.getElementById('retry');
    retry.disabled = true;
    recordAttempt();
    solve().then(function(solution){
      clearTimeout(slowTimer); // solved before the slow beacon fired
      submit(solution).then(function(r){
        if(r.ok || r.status === 302){
          r.json().then(function(){
            window.location.href = safeRedirectTarget(redirect);
          }).catch(function(){ window.location.href = safeRedirectTarget(redirect); });
        } else {
          reportOutcome('verify_rejected');
          retry.disabled = false;
          showFallback();
        }
      }).catch(function(){
        reportOutcome('submit_timeout');
        retry.disabled = false;
        showFallback();
      });
    }).catch(function(){
      reportOutcome('solve_timeout');
      retry.disabled = false;
      showFallback();
    });
  }

  // A nonce is single-use and bound to the client IP server-side: once a submission has been
  // accepted, or the address has rotated, re-POSTing THIS page's nonce can only return 403
  // ("nonce replay" / "invalid solution"). Re-running verify() on click was therefore a
  // permanently dead button — the observed stuck loop. A manual retry navigates back to the
  // target instead, so the proxy mints a fresh challenge with a fresh nonce.
  //
  // The automatic budget is cleared here and ONLY here. The invariant the budget exists for is
  // "no automatic reload loop"; a human clicking is the rate limiter, so resetting on the manual
  // path restores recovery without restoring the loop.
  function manualRetry(){
    document.getElementById('retry').disabled = true;
    try { sessionStorage.setItem(ATTEMPT_KEY, '0'); } catch(e) {}
    window.location.href = redirect;
  }

  document.getElementById('retry').addEventListener('click', manualRetry);
  if(attempts >= MAX_AUTO_ATTEMPTS){
    reportOutcome('fallback_shown');
    showFallback(false);
  } else {
    verify();
  }
})();
</script>
