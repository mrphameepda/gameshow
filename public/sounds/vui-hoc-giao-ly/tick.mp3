*{box-sizing:border-box}
html,body{min-height:100%;margin:0}
body{display:flex;min-height:100vh;flex-direction:column;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans",Arial,sans-serif;-webkit-font-smoothing:antialiased}
.shell{display:flex;flex:1;align-items:center;justify-content:center;padding:var(--sp-8) var(--sp-4)}
article{width:min(100%,32rem);text-align:center}
.brand{display:inline-flex;align-items:center;gap:var(--sp-2);margin-bottom:var(--sp-6);color:var(--op-deep);font-size:.875rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
@media(prefers-color-scheme:dark){.brand{color:var(--op-soft)} }
.brand-mark{width:24px;height:24px}
h1{margin:0;font-size:clamp(1.35rem,4vw,1.75rem);line-height:1.25;letter-spacing:-.01em}
.lede{margin:var(--sp-3) auto 0;max-width:27rem;color:var(--muted);font-size:1rem;line-height:1.6}
.fallback{display:none}
.fallback.visible{display:block}
.fallback h1{margin-bottom:var(--sp-3)}
.support{margin:var(--sp-6) 0 0;color:var(--faint);font-size:.8125rem;line-height:1.5}
.support code{display:inline-block;margin-top:var(--sp-1);padding:2px 6px;border-radius:4px;background:var(--bg);color:var(--text);font:inherit;font-weight:650;overflow-wrap:anywhere}
button{margin-top:var(--sp-6);min-height:44px;padding:var(--sp-3) var(--sp-6);border:2px solid var(--op-primary);border-radius:8px;background:var(--op-primary);color:#171717;font:inherit;font-weight:700;cursor:pointer}
button:hover{background:var(--op-soft);border-color:var(--op-soft)}
button:focus-visible{outline:3px solid var(--op-mid);outline-offset:3px}
button:disabled{opacity:.6;cursor:wait}
.noscript{margin:0;color:var(--muted);font-size:1rem;line-height:1.6}
